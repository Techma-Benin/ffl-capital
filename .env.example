# PostgreSQL — Replit development database (NOT Supabase)
# On Replit: Tools → Database (or Secrets) → copy DATABASE_URL.
# Local: paste the same values from Replit Secrets into both vars below.
# For Prisma migrate, DIRECT_URL can be the same as DATABASE_URL on Replit Postgres.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
DIRECT_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE

# Integration mode: mock | live
INTEGRATIONS_MODE=mock

# Require admin approval for new partner signups
ADMIN_APPROVAL_REQUIRED=true

# Outbound delivery (Resend)
RESEND_API_KEY=
FROM_EMAIL=leads@fflcapital.com
# Set true to log emails locally instead of sending
RESEND_MOCK=true

# Stripe wallet payments
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Cron job authentication (Bearer token for /api/cron/*)
CRON_SECRET=

# IntegrityCONNECT (live mode only)
# RealTime flow (IUL, Mortgage Protection, Final Expense) — direct submit, no ping
INTEGRITY_REALTIME_SUBMIT_URL=https://app.leadconduit.com/flows/65c179646acc6f1fb9864345/sources/64e4ee92a3947cf03fa9dcea/submit
# Storefront / Marketplace flow (aged leads) — supports ping/post protocol
INTEGRITY_STOREFRONT_SUBMIT_URL=https://app.leadconduit.com/flows/60affe1a00048c6680c27719/sources/64e4ee92a3947cf03fa9dcea/submit
# Shared secret for the Integrity result-callback webhook (POST /api/webhooks/integrity)
INTEGRITY_WEBHOOK_SECRET=

# LeadConduit intake security — shared secret for POST /api/leads/intake
# Set this and configure X-Api-Key header in LeadConduit delivery settings
# If not set, the check is skipped (safe for local dev)
LEADCONDUIT_WEBHOOK_SECRET=

# App URL (local default 3000; Replit workflow uses port 5000)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Clerk auth — paste from Clerk dashboard or Replit Secrets
# Replit may set CLERK_PUBLISHABLE_KEY; Next.js also accepts NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY
# (next.config.mjs maps CLERK_PUBLISHABLE_KEY → NEXT_PUBLIC_*)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/auth/continue?portal=partner
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/auth/continue?portal=partner

# Comma-separated emails allowed to use /admin/sign-in (auto-promoted to admin role)
ADMIN_EMAILS=
