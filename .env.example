# PostgreSQL (Supabase) — Prisma connection pooling
# Project: FFL Capital (wbzvyvtlopoghvdqltxm, eu-west-3)
# Dashboard: https://supabase.com/dashboard/project/wbzvyvtlopoghvdqltxm
# Transaction pooler (port 6543) — use in production/serverless when reachable
# DATABASE_URL=postgresql://postgres.wbzvyvtlopoghvdqltxm:[YOUR-PASSWORD]@aws-0-eu-west-3.pooler.supabase.com:6543/postgres?pgbouncer=true
# Session pooler (port 5432) — reliable for local dev when 6543 is blocked
DATABASE_URL=postgresql://postgres.wbzvyvtlopoghvdqltxm:[YOUR-PASSWORD]@aws-0-eu-west-3.pooler.supabase.com:5432/postgres?pgbouncer=true

# Direct connection for Prisma migrations
DIRECT_URL=postgresql://postgres.wbzvyvtlopoghvdqltxm:[YOUR-PASSWORD]@aws-0-eu-west-3.pooler.supabase.com:5432/postgres

# Integration mode: mock | live
INTEGRATIONS_MODE=mock

# Require admin approval for new partner signups
ADMIN_APPROVAL_REQUIRED=true

# Outbound delivery (Resend) — lead emails + partner Contact Us
# Contact Us also needs FROM_EMAIL; recipient is set in Admin → Settings → General
# (defaults to support@fflcapital.com when unset).
RESEND_API_KEY=
FROM_EMAIL=leads@fflcapital.com
# RESEND_MOCK=true  # optional: send via onboarding@resend.dev in local/dev

# Stripe wallet payments
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Cron job authentication (Bearer token for /api/cron/*)
CRON_SECRET=

# IntegrityCONNECT (live mode only)
INTEGRITY_PING_URL=
INTEGRITY_POST_URL=

# App URL for Stripe redirects
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Clerk auth (Phase 1b) — https://dashboard.clerk.com
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/auth/continue?portal=partner
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/auth/continue?portal=partner

# Comma-separated emails allowed to use /admin/sign-in (auto-promoted to admin role)
ADMIN_EMAILS=
