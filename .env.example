# PostgreSQL (Supabase) — Prisma connection pooling
# Project: FFL Capital (wbzvyvtlopoghvdqltxm, eu-west-3)
# Dashboard: https://supabase.com/dashboard/project/wbzvyvtlopoghvdqltxm
# IMPORTANT: Do NOT use transaction pooler port 6543 for this app — interactive
# $transaction (matching, wallet, refunds) will fail with P2028 "Transaction not found".
# Use Session pooler (port 5432) or the direct db.* host.
# Transaction pooler (port 6543) — only if you remove interactive transactions
# DATABASE_URL=postgresql://postgres.wbzvyvtlopoghvdqltxm:[YOUR-PASSWORD]@aws-0-eu-west-3.pooler.supabase.com:6543/postgres?pgbouncer=true
# Session pooler (port 5432) — required for local/prod with Prisma interactive txs
DATABASE_URL=postgresql://postgres.wbzvyvtlopoghvdqltxm:[YOUR-PASSWORD]@aws-0-eu-west-3.pooler.supabase.com:5432/postgres?pgbouncer=true

# Replit: enable the PostgreSQL module — Replit sets DATABASE_URL automatically (Secrets).
# Local: copy this file to .env and set DATABASE_URL (Supabase session pooler or direct host).

# Integration mode fallback when app_settings.integrations_mode is unset.
# Admin Mode dropdown on Integrations saves to DB and takes precedence over env.
# Production defaults to live when neither DB nor env is set (.replit sets INTEGRATIONS_MODE=live).
INTEGRATIONS_MODE=mock

# Require admin approval for new partner signups
ADMIN_APPROVAL_REQUIRED=true

# Outbound delivery (Resend) — lead emails + partner Contact Us
# Contact Us also needs FROM_EMAIL; recipient is set in Admin → Settings → General
# (defaults to support@fflcapital.com when unset).
RESEND_API_KEY=
FROM_EMAIL=leads@capitalleadssolutions.com
# RESEND_MOCK=true  # optional: send via onboarding@resend.dev in local/dev

# Stripe wallet payments
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Cron job authentication (Bearer token for /api/cron/*)
# Local dev: if unset, server accepts `dev-cron-secret` when NODE_ENV=development
CRON_SECRET=

# IntegrityCONNECT — URLs used when resale vendor Post URL is blank in admin
# RealTime flow (IUL, Mortgage Protection, Final Expense) — direct submit, no ping
INTEGRITY_REALTIME_SUBMIT_URL=https://app.leadconduit.com/flows/65c179646acc6f1fb9864345/sources/64e4ee92a3947cf03fa9dcea/submit
# Storefront / Marketplace flow (aged leads) — direct post, no ping gate
INTEGRITY_STOREFRONT_SUBMIT_URL=https://app.leadconduit.com/flows/60affe1a00048c6680c27719/sources/64e4ee92a3947cf03fa9dcea/submit
# Azure IsAcceptingCampaign ping for Realtime IUL only (env-only secrets; never store in DB)
# After pull: `pnpm run ensure:integrity-env` (also via scripts/post-merge.sh) fills blank defaults.
# On Replit, Secrets already in the UI win; the script writes .env when writable and prints which secrets to add.
INTEGRITY_REALTIME_PING_URL=https://ilc-functions-prod.azurewebsites.net/api/IsAcceptingCampaign
INTEGRITY_PING_VENDOR_ID=
INTEGRITY_PING_FUNCTIONS_KEY=
# Optional overrides for scripts/preflight:integrity-azure
# INTEGRITY_TEST_STATE=TX
# INTEGRITY_TEST_POSTAL_CODE=78701
# INTEGRITY_TEST_LEAD_TYPE=Indexed Universal Life [IUL] Facebook (Realtime Lead)
# Shared secret for the Integrity result-callback webhook (POST /api/webhooks/integrity)
INTEGRITY_WEBHOOK_SECRET=

# LeadConduit intake security — shared secret for POST /api/leads/intake
# Set this and configure X-Api-Key header in LeadConduit delivery settings
# If not set, the check is skipped (safe for local dev)
LEADCONDUIT_WEBHOOK_SECRET=

# App URL for Stripe redirects
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional: base URL for scripts/verify-backend.mjs and verify-cron.mjs (defaults: local :3000, Replit :5000)
# API_BASE_URL=http://127.0.0.1:3000

# Clerk auth (Phase 1b) — https://dashboard.clerk.com
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/auth/continue?portal=partner
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/auth/continue?portal=partner

# Comma-separated emails allowed to use /admin/sign-in (auto-promoted to admin role)
ADMIN_EMAILS=
