+import { NextRequest, NextResponse } from "next/server";
+import { prisma } from "@/lib/db";
+import { requireAdmin } from "@/lib/auth/session";
+import { intakeRequiredFieldUpdateSchema } from "@/lib/intake/required-fields-config";
+
+/** PATCH /api/admin/intake-required-fields/[id] — update label, description, enabled, sortOrder */
+export async function PATCH(
+  request: NextRequest,
+  { params }: { params: Promise<{ id: string }> },
+) {
+  const auth = await requireAdmin();
+  if ("error" in auth) {
+    return NextResponse.json({ error: auth.error }, { status: 403 });
+  }
+
+  const { id } = await params;
+  const existing = await prisma.intakeRequiredField.findUnique({ where: { id } });
+  if (!existing) {
+    return NextResponse.json({ error: "Not found" }, { status: 404 });
+  }
+
+  const body = await request.json();
+  const parsed = intakeRequiredFieldUpdateSchema.safeParse(body);
+  if (!parsed.success) {
+    return NextResponse.json(
+      { error: "Invalid payload", issues: parsed.error.issues },
+      { status: 400 },
+    );
+  }
+
+  const field = await prisma.intakeRequiredField.update({
+    where: { id },
+    data: {
+      ...(parsed.data.label !== undefined ? { label: parsed.data.label } : {}),
+      ...(parsed.data.description !== undefined
+        ? { description: parsed.data.description }
+        : {}),
+      ...(parsed.data.enabled !== undefined ? { enabled: parsed.data.enabled } : {}),
+      ...(parsed.data.sortOrder !== undefined
+        ? { sortOrder: parsed.data.sortOrder }
+        : {}),
+    },
+  });
+
+  return NextResponse.json({ field });
+}
+
+/** DELETE /api/admin/intake-required-fields/[id] — remove a field from intake requirements */
+export async function DELETE(
+  _request: NextRequest,
+  { params }: { params: Promise<{ id: string }> },
+) {
+  const auth = await requireAdmin();
+  if ("error" in auth) {
+    return NextResponse.json({ error: auth.error }, { status: 403 });
+  }
+
+  const { id } = await params;
+  const existing = await prisma.intakeRequiredField.findUnique({ where: { id } });
+  if (!existing) {
+    return NextResponse.json({ error: "Not found" }, { status: 404 });
+  }
+
+  await prisma.intakeRequiredField.delete({ where: { id } });
+  return NextResponse.json({ deleted: true });
+}
