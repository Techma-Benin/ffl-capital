+"use client";
+
+import { useEffect, useState } from "react";
+import { useRouter } from "next/navigation";
+import { notify } from "@/lib/notify";
+
+interface IntakeRequiredField {
+  id: string;
+  fieldKey: string;
+  label: string;
+  description: string | null;
+  enabled: boolean;
+  sortOrder: number;
+}
+
+interface FieldFormData {
+  fieldKey: string;
+  label: string;
+  description: string;
+  enabled: boolean;
+}
+
+function emptyForm(): FieldFormData {
+  return {
+    fieldKey: "",
+    label: "",
+    description: "",
+    enabled: true,
+  };
+}
+
+function fieldToForm(field: IntakeRequiredField): FieldFormData {
+  return {
+    fieldKey: field.fieldKey,
+    label: field.label,
+    description: field.description ?? "",
+    enabled: field.enabled,
+  };
+}
+
+function ModalOverlay({
+  title,
+  onClose,
+  children,
+}: {
+  title: string;
+  onClose: () => void;
+  children: React.ReactNode;
+}) {
+  return (
+    <div
+      className="fixed inset-0 z-50 flex items-center justify-center bg-black/40"
+      onClick={(e) => e.target === e.currentTarget && onClose()}
+    >
+      <div className="bg-white rounded-xl shadow-xl w-full max-w-lg mx-4">
+        <div className="flex items-center justify-between px-6 py-4 border-b border-slate-200">
+          <h3 className="font-semibold text-slate-900">{title}</h3>
+          <button
+            type="button"
+            onClick={onClose}
+            className="text-slate-400 hover:text-slate-600 text-xl leading-none"
+          >
+            ×
+          </button>
+        </div>
+        <div className="px-6 py-5 space-y-4">{children}</div>
+      </div>
+    </div>
+  );
+}
+
+function Field({
+  label,
+  hint,
+  children,
+}: {
+  label: string;
+  hint?: string;
+  children: React.ReactNode;
+}) {
+  return (
+    <div>
+      <label className="form-label mb-1">{label}</label>
+      {hint && <p className="text-xs text-slate-400 mb-1">{hint}</p>}
+      {children}
+    </div>
+  );
+}
+
+function FieldModal({
+  initial,
+  isNew,
+  onSave,
+  onDelete,
+  onClose,
+}: {
+  initial: FieldFormData;
+  isNew: boolean;
+  onSave: (data: FieldFormData) => Promise<void>;
+  onDelete?: () => Promise<void>;
+  onClose: () => void;
+}) {
+  const [form, setForm] = useState<FieldFormData>(initial);
+  const [pending, setPending] = useState(false);
+  const [confirmDelete, setConfirmDelete] = useState(false);
+
+  async function handleSubmit(e: React.FormEvent) {
+    e.preventDefault();
+    setPending(true);
+    try {
+      await onSave(form);
+    } catch (err) {
+      notify.error(err instanceof Error ? err.message : "Save failed");
+    } finally {
+      setPending(false);
+    }
+  }
+
+  async function handleDelete() {
+    if (!onDelete) return;
+    setPending(true);
+    try {
+      await onDelete();
+    } catch (err) {
+      notify.error(err instanceof Error ? err.message : "Delete failed");
+    } finally {
+      setPending(false);
+    }
+  }
+
+  return (
+    <ModalOverlay
+      title={isNew ? "Add intake field" : `Edit — ${initial.fieldKey}`}
+      onClose={onClose}
+    >
+      <form onSubmit={handleSubmit} className="space-y-4">
+        <Field
+          label="Field key"
+          hint="Boberdoo/LeadConduit field name (e.g. Trusted_Form_URL, DOB)"
+        >
+          <input
+            type="text"
+            value={form.fieldKey}
+            onChange={(e) => setForm({ ...form, fieldKey: e.target.value })}
+            disabled={!isNew}
+            placeholder="Trusted_Form_URL"
+            className="form-input font-mono text-sm disabled:bg-slate-50 disabled:text-slate-500"
+            required
+          />
+        </Field>
+
+        <Field label="Label">
+          <input
+            type="text"
+            value={form.label}
+            onChange={(e) => setForm({ ...form, label: e.target.value })}
+            className="form-input text-sm"
+            required
+          />
+        </Field>
+
+        <Field label="Description" hint="Optional admin note">
+          <textarea
+            value={form.description}
+            onChange={(e) => setForm({ ...form, description: e.target.value })}
+            className="form-input text-sm min-h-[72px]"
+          />
+        </Field>
+
+        <label className="flex items-center gap-2 text-sm text-slate-700">
+          <input
+            type="checkbox"
+            checked={form.enabled}
+            onChange={(e) => setForm({ ...form, enabled: e.target.checked })}
+            className="rounded border-slate-300"
+          />
+          Required at intake
+        </label>
+
+        <div className="flex items-center gap-3 pt-2 border-t border-slate-100">
+          <button type="submit" disabled={pending} className="btn-primary btn-sm">
+            Save
+          </button>
+          <button
+            type="button"
+            onClick={onClose}
+            className="btn-sm border border-slate-200 text-slate-600 hover:bg-slate-50 rounded-lg px-3 py-1.5 text-sm font-medium"
+          >
+            Cancel
+          </button>
+          {!isNew && onDelete && !confirmDelete && (
+            <button
+              type="button"
+              onClick={() => setConfirmDelete(true)}
+              className="ml-auto text-xs text-red-500 hover:text-red-700 font-medium"
+            >
+              Delete
+            </button>
+          )}
+          {!isNew && onDelete && confirmDelete && (
+            <div className="ml-auto flex items-center gap-2">
+              <button
+                type="button"
+                onClick={handleDelete}
+                disabled={pending}
+                className="text-xs text-red-600 font-semibold hover:text-red-800"
+              >
+                Confirm delete
+              </button>
+              <button
+                type="button"
+                onClick={() => setConfirmDelete(false)}
+                className="text-xs text-slate-400 hover:text-slate-600"
+              >
+                Cancel
+              </button>
+            </div>
+          )}
+        </div>
+      </form>
+    </ModalOverlay>
+  );
+}
+
+function ToggleSwitch({
+  checked,
+  disabled,
+  onChange,
+}: {
+  checked: boolean;
+  disabled?: boolean;
+  onChange: (value: boolean) => void;
+}) {
+  return (
+    <button
+      type="button"
+      role="switch"
+      aria-checked={checked}
+      disabled={disabled}
+      onClick={(e) => {
+        e.stopPropagation();
+        onChange(!checked);
+      }}
+      style={{
+        width: 40,
+        height: 23,
+        borderRadius: 20,
+        position: "relative",
+        flexShrink: 0,
+        cursor: disabled ? "not-allowed" : "pointer",
+        border: "none",
+        background: checked ? "#3A974C" : "#d7d6e0",
+        opacity: disabled ? 0.6 : 1,
+        transition: "background 0.18s",
+      }}
+    >
+      <i
+        style={{
+          position: "absolute",
+          top: 3,
+          left: checked ? 20 : 3,
+          width: 17,
+          height: 17,
+          borderRadius: "50%",
+          background: "#fff",
+          transition: "left 0.18s",
+        }}
+      />
+    </button>
+  );
+}
+
+const IconIntake = () => (
+  <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="#605BFF" strokeWidth={2}>
+    <path d="M4 6h16M4 12h10M4 18h14" />
+  </svg>
+);
+
+const IconTrash = () => (
+  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth={2}>
+    <path d="M3 6h18M8 6V4h8v2M6 6l1 14h10l1-14" />
+  </svg>
+);
+
+export function IntakeRequiredFieldsManager() {
+  const router = useRouter();
+  const [fields, setFields] = useState<IntakeRequiredField[]>([]);
+  const [loading, setLoading] = useState(true);
+  const [togglingId, setTogglingId] = useState<string | null>(null);
+  const [modal, setModal] = useState<{
+    form: FieldFormData;
+    field: IntakeRequiredField | null;
+  } | null>(null);
+
+  async function load() {
+    setLoading(true);
+    try {
+      const res = await fetch("/api/admin/intake-required-fields");
+      const data = await res.json();
+      setFields(data.fields ?? []);
+    } finally {
+      setLoading(false);
+    }
+  }
+
+  useEffect(() => {
+    load();
+  }, []);
+
+  async function handleToggle(field: IntakeRequiredField, enabled: boolean) {
+    setTogglingId(field.id);
+    try {
+      const res = await fetch(`/api/admin/intake-required-fields/${field.id}`, {
+        method: "PATCH",
+        headers: { "Content-Type": "application/json" },
+        body: JSON.stringify({ enabled }),
+      });
+      if (!res.ok) throw new Error("Toggle failed");
+      setFields((prev) =>
+        prev.map((row) => (row.id === field.id ? { ...row, enabled } : row)),
+      );
+      notify.success(enabled ? "Field required at intake" : "Field optional at intake");
+      router.refresh();
+    } catch {
+      notify.error("Failed to update field");
+    } finally {
+      setTogglingId(null);
+    }
+  }
+
+  async function handleSave(data: FieldFormData) {
+    const isNew = modal?.field === null;
+    const url = isNew
+      ? "/api/admin/intake-required-fields"
+      : `/api/admin/intake-required-fields/${modal!.field!.id}`;
+
+    const body = isNew
+      ? {
+          fieldKey: data.fieldKey.trim(),
+          label: data.label.trim(),
+          description: data.description.trim() || null,
+          enabled: data.enabled,
+        }
+      : {
+          label: data.label.trim(),
+          description: data.description.trim() || null,
+          enabled: data.enabled,
+        };
+
+    const res = await fetch(url, {
+      method: isNew ? "POST" : "PATCH",
+      headers: { "Content-Type": "application/json" },
+      body: JSON.stringify(body),
+    });
+
+    if (!res.ok) {
+      const err = await res.json().catch(() => ({}));
+      throw new Error(err.error ?? "Save failed");
+    }
+
+    setModal(null);
+    notify.success(isNew ? "Field added" : "Field saved");
+    await load();
+    router.refresh();
+  }
+
+  async function handleDelete(field: IntakeRequiredField) {
+    const res = await fetch(`/api/admin/intake-required-fields/${field.id}`, {
+      method: "DELETE",
+    });
+    if (!res.ok) {
+      const err = await res.json().catch(() => ({}));
+      throw new Error(err.error ?? "Delete failed");
+    }
+    setModal(null);
+    notify.success("Field removed");
+    await load();
+    router.refresh();
+  }
+
+  return (
+    <>
+      {modal && (
+        <FieldModal
+          initial={modal.form}
+          isNew={modal.field === null}
+          onSave={handleSave}
+          onDelete={
+            modal.field
+              ? async () => {
+                  await handleDelete(modal.field!);
+                }
+              : undefined
+          }
+          onClose={() => setModal(null)}
+        />
+      )}
+
+      <div className="bg-white rounded-[14px] shadow-[0_6px_24px_-14px_rgba(79,78,105,0.25)] overflow-hidden">
+        <div
+          style={{
+            display: "flex",
+            alignItems: "center",
+            gap: 11,
+            padding: "15px 20px",
+            borderBottom: "1px solid #f4f3f8",
+          }}
+        >
+          <span
+            style={{
+              width: 32,
+              height: 32,
+              borderRadius: 9,
+              background: "rgba(96,91,255,0.12)",
+              display: "flex",
+              alignItems: "center",
+              justifyContent: "center",
+              flexShrink: 0,
+            }}
+          >
+            <IconIntake />
+          </span>
+          <span style={{ fontSize: 15, fontWeight: 800, color: "#030229" }}>
+            Intake required fields
+          </span>
+          <span style={{ fontSize: 13, color: "#8b8a99", marginLeft: 4 }}>
+            Fields LeadConduit must send before a lead is accepted
+          </span>
+          <span style={{ flex: 1 }} />
+          <button
+            type="button"
+            onClick={() => setModal({ form: emptyForm(), field: null })}
+            className="btn-secondary btn-sm whitespace-nowrap"
+          >
+            + Add field
+          </button>
+        </div>
+
+        {loading ? (
+          <p className="px-5 py-6 text-sm text-[#8b8a99]">Loading…</p>
+        ) : (
+          <table className="w-full" style={{ borderCollapse: "collapse" }}>
+            <thead>
+              <tr>
+                {["Field", "Description", "Required", "Actions"].map((col, i) => (
+                  <th
+                    key={col}
+                    className="px-3.5 py-2.5 text-xs font-extrabold text-[#b3b3bf] uppercase tracking-wide bg-[#f7f7fb] border-b border-[#f0eef6] whitespace-nowrap"
+                    style={{ textAlign: i === 3 ? "right" : "left" }}
+                  >
+                    {col}
+                  </th>
+                ))}
+              </tr>
+            </thead>
+            <tbody>
+              {fields.map((field, idx) => (
+                <tr
+                  key={field.id}
+                  onClick={() => setModal({ form: fieldToForm(field), field })}
+                  className="cursor-pointer hover:bg-[#fbfbfe] transition-colors"
+                  style={{
+                    borderBottom:
+                      idx < fields.length - 1 ? "1px solid #f4f3f8" : "none",
+                  }}
+                >
+                  <td className="px-3.5 py-[11px]">
+                    <div style={{ fontSize: 14, fontWeight: 700, color: "#030229" }}>
+                      {field.label}
+                    </div>
+                    <div
+                      style={{
+                        fontFamily: "ui-monospace, monospace",
+                        fontSize: 12,
+                        color: "#8b8a99",
+                        marginTop: 2,
+                      }}
+                    >
+                      {field.fieldKey}
+                    </div>
+                  </td>
+                  <td
+                    className="px-3.5 py-[11px]"
+                    style={{ fontSize: 13, color: "#8b8a99", maxWidth: 320 }}
+                  >
+                    {field.description || "—"}
+                  </td>
+                  <td className="px-3.5 py-[11px]">
+                    <ToggleSwitch
+                      checked={field.enabled}
+                      disabled={togglingId === field.id}
+                      onChange={(enabled) => handleToggle(field, enabled)}
+                    />
+                  </td>
+                  <td className="px-3.5 py-[11px]" style={{ textAlign: "right" }}>
+                    <button
+                      type="button"
+                      onClick={(e) => {
+                        e.stopPropagation();
+                        void handleDelete(field);
+                      }}
+                      className="inline-flex items-center justify-center rounded-lg transition-colors"
+                      style={{
+                        width: 30,
+                        height: 30,
+                        border: "1.5px solid #ececf3",
+                        background: "#fff",
+                        color: "#8b8a99",
+                        cursor: "pointer",
+                      }}
+                    >
+                      <IconTrash />
+                    </button>
+                  </td>
+                </tr>
+              ))}
+              {fields.length === 0 && (
+                <tr>
+                  <td
+                    colSpan={4}
+                    className="px-3.5 py-6 text-center text-sm text-[#8b8a99]"
+                  >
+                    No intake fields configured — defaults apply until you add fields
+                  </td>
+                </tr>
+              )}
+            </tbody>
+          </table>
+        )}
+      </div>
+    </>
+  );
+}
