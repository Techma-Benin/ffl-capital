+import { NextRequest, NextResponse } from "next/server";
+import { Prisma } from "@prisma/client";
+import { prisma } from "@/lib/db";
+import { requireAdmin } from "@/lib/auth/session";
+import {
+  intakeRequiredFieldCreateSchema,
+} from "@/lib/intake/required-fields-config";
+
+/** GET /api/admin/intake-required-fields — list all configured fields */
+export async function GET() {
+  const auth = await requireAdmin();
+  if ("error" in auth) {
+    return NextResponse.json({ error: auth.error }, { status: 403 });
+  }
+
+  const fields = await prisma.intakeRequiredField.findMany({
+    orderBy: [{ sortOrder: "asc" }, { fieldKey: "asc" }],
+  });
+
+  return NextResponse.json({ fields });
+}
+
+/** POST /api/admin/intake-required-fields — add a new required field */
+export async function POST(request: NextRequest) {
+  const auth = await requireAdmin();
+  if ("error" in auth) {
+    return NextResponse.json({ error: auth.error }, { status: 403 });
+  }
+
+  const body = await request.json();
+  const parsed = intakeRequiredFieldCreateSchema.safeParse(body);
+  if (!parsed.success) {
+    return NextResponse.json(
+      { error: "Invalid payload", issues: parsed.error.issues },
+      { status: 400 },
+    );
+  }
+
+  const maxSort = await prisma.intakeRequiredField.aggregate({
+    _max: { sortOrder: true },
+  });
+  const sortOrder =
+    parsed.data.sortOrder ?? (maxSort._max.sortOrder ?? 0) + 10;
+
+  try {
+    const field = await prisma.intakeRequiredField.create({
+      data: {
+        fieldKey: parsed.data.fieldKey,
+        label: parsed.data.label,
+        description: parsed.data.description ?? null,
+        enabled: parsed.data.enabled ?? true,
+        sortOrder,
+      },
+    });
+    return NextResponse.json({ field }, { status: 201 });
+  } catch (error) {
+    if (
+      error instanceof Prisma.PrismaClientKnownRequestError &&
+      error.code === "P2002"
+    ) {
+      return NextResponse.json(
+        { error: `Field key "${parsed.data.fieldKey}" already exists` },
+        { status: 409 },
+      );
+    }
+    throw error;
+  }
+}
