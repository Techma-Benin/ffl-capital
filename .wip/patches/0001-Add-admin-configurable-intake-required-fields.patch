+CREATE TABLE "intake_required_fields" (
+  "id" UUID NOT NULL DEFAULT gen_random_uuid(),
+  "field_key" TEXT NOT NULL,
+  "label" TEXT NOT NULL,
+  "description" TEXT,
+  "enabled" BOOLEAN NOT NULL DEFAULT true,
+  "sort_order" INTEGER NOT NULL DEFAULT 0,
+  "created_at" TIMESTAMPTZ NOT NULL DEFAULT now(),
+  "updated_at" TIMESTAMPTZ NOT NULL DEFAULT now(),
+  CONSTRAINT "intake_required_fields_pkey" PRIMARY KEY ("id")
+);
+
+CREATE UNIQUE INDEX "intake_required_fields_field_key_key"
+  ON "intake_required_fields"("field_key");
+
+-- Defaults match current intake behavior: core contact + TrustedForm required; DOB optional.
