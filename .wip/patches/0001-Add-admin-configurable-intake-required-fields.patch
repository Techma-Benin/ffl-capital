+  ('Email', 'Email', 'Lead email address', true, 30),
+  ('Primary_Phone', 'Phone', 'Lead primary phone number', true, 40),
+  ('State', 'State', 'Two-letter state code', true, 50),
+  ('Trusted_Form_URL', 'TrustedForm URL', 'TrustedForm certificate URL for compliance', true, 60),
+  ('DOB', 'Date of birth', 'Optional at intake; Integrity still validates before post', false, 70);
