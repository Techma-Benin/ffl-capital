new file mode 100644
index 0000000..c84851c
--- /dev/null
+++ b/src/lib/intake/required-fields-config.ts
@@ -0,0 +1,187 @@
+import { z } from "zod";
+import { prisma } from "@/lib/db";
+
+export interface IntakeRequiredFieldConfig {
+  id?: string;
+  fieldKey: string;
+  label: string;
+  description?: string | null;
+  enabled: boolean;
+  sortOrder?: number;
+}
+
+/** Fallback when the DB table is empty (e.g. before migration). */
+export const DEFAULT_INTAKE_REQUIRED_FIELDS: IntakeRequiredFieldConfig[] = [
+  {
+    fieldKey: "First_Name",
+    label: "First name",
+    description: "Lead first name",
+    enabled: true,
+    sortOrder: 10,
+  },
+  {
+    fieldKey: "Last_Name",
+    label: "Last name",
+    description: "Lead last name",
+    enabled: true,
+    sortOrder: 20,
+  },
+  {
+    fieldKey: "Email",
+    label: "Email",
+    description: "Lead email address",
+    enabled: true,
+    sortOrder: 30,
+  },
+  {
+    fieldKey: "Primary_Phone",
+    label: "Phone",
+    description: "Lead primary phone number",
+    enabled: true,
+    sortOrder: 40,
+  },
+  {
+    fieldKey: "State",
+    label: "State",
+    description: "Two-letter state code",
+    enabled: true,
+    sortOrder: 50,
+  },
+  {
+    fieldKey: "Trusted_Form_URL",
+    label: "TrustedForm URL",
+    description: "TrustedForm certificate URL for compliance",
+    enabled: true,
+    sortOrder: 60,
+  },
+  {
+    fieldKey: "DOB",
+    label: "Date of birth",
+    description: "Optional at intake; Integrity still validates before post",
+    enabled: false,
+    sortOrder: 70,
+  },
+];
+
+const FIELD_RESOLVERS: Record<
+  string,
+  (data: Record<string, unknown>) => unknown
+> = {
+  First_Name: (data) => data.First_Name ?? data.firstName,
+  Last_Name: (data) => data.Last_Name ?? data.lastName,
+  Email: (data) => data.Email ?? data.email,
+  Primary_Phone: (data) => data.Primary_Phone ?? data.phone,
+  State: (data) =>
+    data.State ??
+    data.State_You_Currently_Live_In ??
+    data.stateYouCurrentlyLiveIn ??
+    data.state,
+  DOB: (data) => data.DOB ?? data.dob,
+  Trusted_Form_URL: (data) =>
+    data.Trusted_Form_URL ??
+    data.trustedformCertUrl ??
+    data.trustedform_cert_url ??
+    data.trusted_form_url,
+  Have_IUL: (data) => data.Have_IUL ?? data.haveIul,
+  Primary_Goal: (data) => data.Primary_Goal ?? data.primaryGoal,
+  Beneficiary: (data) => data.Beneficiary ?? data.beneficiary,
+  History_Of_Cancer: (data) =>
+    data.History_Of_Cancer ?? data.historyOfCancer,
+  Mortgage_Loan_Amount: (data) =>
+    data.Mortgage_Loan_Amount ?? data.mortgageLoanAmount,
+};
+
+function isPresent(value: unknown): boolean {
+  if (value === null || value === undefined) return false;
+  if (typeof value === "string") return value.trim() !== "";
+  return true;
+}
+
+export function resolveIntakeFieldValue(
+  data: Record<string, unknown>,
+  fieldKey: string,
+): unknown {
+  const resolver = FIELD_RESOLVERS[fieldKey];
+  if (resolver) return resolver(data);
+  return data[fieldKey];
+}
+
+export function missingIntakeRequiredFields(
+  data: Record<string, unknown>,
+  fields: IntakeRequiredFieldConfig[],
+): string[] {
+  const missing: string[] = [];
+  for (const field of fields) {
+    if (!field.enabled) continue;
+    if (!isPresent(resolveIntakeFieldValue(data, field.fieldKey))) {
+      missing.push(field.fieldKey);
+    }
+  }
+  return missing;
+}
+
+export async function getIntakeRequiredFields(): Promise<
+  IntakeRequiredFieldConfig[]
+> {
+  const rows = await prisma.intakeRequiredField.findMany({
+    orderBy: [{ sortOrder: "asc" }, { fieldKey: "asc" }],
+  });
+  if (rows.length === 0) {
+    return DEFAULT_INTAKE_REQUIRED_FIELDS;
+  }
+  return rows.map((row) => ({
+    id: row.id,
+    fieldKey: row.fieldKey,
+    label: row.label,
+    description: row.description,
+    enabled: row.enabled,
+    sortOrder: row.sortOrder,
+  }));
+}
+
+export async function getEnabledIntakeRequiredFields(): Promise<
+  IntakeRequiredFieldConfig[]
+> {
+  const fields = await getIntakeRequiredFields();
+  return fields.filter((field) => field.enabled);
+}
+
+export async function seedIntakeRequiredFields(): Promise<void> {
+  for (const field of DEFAULT_INTAKE_REQUIRED_FIELDS) {
+    await prisma.intakeRequiredField.upsert({
+      where: { fieldKey: field.fieldKey },
+      create: {
+        fieldKey: field.fieldKey,
+        label: field.label,
+        description: field.description ?? null,
+        enabled: field.enabled,
+        sortOrder: field.sortOrder ?? 0,
+      },
+      update: {},
+    });
+  }
+}
+
+export const intakeRequiredFieldKeySchema = z
+  .string()
+  .min(1)
+  .max(80)
+  .regex(
+    /^[A-Za-z][A-Za-z0-9_]*$/,
+    "Field key must start with a letter and contain only letters, numbers, and underscores",
+  );
+
+export const intakeRequiredFieldCreateSchema = z.object({
+  fieldKey: intakeRequiredFieldKeySchema,
+  label: z.string().min(1).max(120),
+  description: z.string().max(500).optional().nullable(),
+  enabled: z.boolean().optional(),
+  sortOrder: z.number().int().min(0).max(9999).optional(),
+});
+
+export const intakeRequiredFieldUpdateSchema = z.object({
+  label: z.string().min(1).max(120).optional(),
+  description: z.string().max(500).optional().nullable(),
+  enabled: z.boolean().optional(),
+  sortOrder: z.number().int().min(0).max(9999).optional(),
+});
