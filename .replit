modules = ["nodejs-24", "postgresql-16"]
[nix]
channel = "stable-25_05"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "npm run dev -- -p 5000"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 8080
externalPort = 8080

[[ports]]
localPort = 18966
externalPort = 3001

[agent]
expertMode = true

[userenv]

[userenv.shared]
ADMIN_EMAILS = "bill.ahognonvi+admin@techma.ca"

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 120000
